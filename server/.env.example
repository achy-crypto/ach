# ---------------------------------------------------------------------------
# Two Hours In — server configuration. Copy to .env and fill in.
# Every secret stays on this side; the browser never sees one.
# ---------------------------------------------------------------------------

# REQUIRED — rates gameplay features with Claude.
# Get one at https://console.anthropic.com  →  API keys
ANTHROPIC_API_KEY=sk-ant-...

# Which model rates games. Leave as-is unless you have a reason.
ANTHROPIC_MODEL=claude-opus-5

# REQUIRED — pick ONE catalog provider and fill in its credentials.
#   igdb  — much better metadata (game modes, genres, themes, summaries). Free.
#   rawg  — simpler to set up, one key. Free tier is 20k requests/month.
CATALOG_PROVIDER=igdb

# --- IGDB (via Twitch) ------------------------------------------------------
# 1. Sign in at https://dev.twitch.tv/console/apps  →  Register Your Application
# 2. Name: anything. OAuth Redirect URL: http://localhost  Category: Application Integration
# 3. Manage → copy the Client ID, then New Secret → copy the Client Secret
# The server exchanges these for an app access token itself and refreshes it.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- RAWG (alternative) -----------------------------------------------------
# Sign up at https://rawg.io/apidocs → the key is shown on your profile page
RAWG_API_KEY=

# --- TMDb: shows and films, for Will It Hold at /holds -----------------------
# Sign up at https://www.themoviedb.org/signup, then Settings -> API ->
# "Request an API key" -> Developer. Free, approved in minutes.
# Supply EITHER the v3 API key or the v4 Read Access Token; one is enough.
TMDB_API_KEY=
# TMDB_READ_TOKEN=

# --- Optional ---------------------------------------------------------------
# Set to require a shared password before the app will talk to this server.
# Strongly recommended if you deploy it anywhere public: without it, anyone who
# finds the URL can spend your Anthropic credit.
APP_TOKEN=

PORT=8787
# Where state.json and ratings.json are written. Use a mounted volume in prod.
DATA_DIR=./data
